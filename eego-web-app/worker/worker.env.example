# Save the filled-in file outside the repository and chmod 600 it.
EEGO_API_URL=https://eego-api.zetbros.workers.dev/api/eego
EEGO_WORKER_TOKEN=REPLACE_WITH_64_HEX_CHARACTER_PRIVATE_WORKER_TOKEN
CODEX_HOME=/home/ubuntu/.config/eego/codex
CODEX_BIN=/home/ubuntu/eego/bin/codex-x86_64-unknown-linux-musl
CODEX_MODEL=gpt-6-luna
EEGO_POLL_SECONDS=3
