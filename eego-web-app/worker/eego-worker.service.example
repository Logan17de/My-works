[Unit]
Description=Eego private Codex question generator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/eego
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/ubuntu/eego/worker.py --env /home/ubuntu/.config/eego/worker.env
Restart=always
RestartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/.config/eego/codex
UMask=0077

[Install]
WantedBy=multi-user.target
