{
  "model": {
    "hidden_size": 256,
    "num_layers": 8,
    "num_experts": 64,
    "num_shared_experts": 4,
    "top_k": 4,
    "expert_intermediate_size": 2048,
    "router_activation": "sigmoid",
    "hc_count": 4,
    "hc_lowrank": 32,
    "full_attention_interval": 4
  },
  "threshold": {
    "enabled": true,
    "warmup_tokens": -1,
    "imbalance_threshold": 0.30,
    "block_fraction": 0.30
  },
  "data": {
    "source": "k2-txt360-v2",
    "config_name": "web-high-nltk-qa",
    "sequence_length": 8192,
    "shuffle_buffer": 1000
  },
  "training": {
    "run_name": "research-8l-64e-8k",
    "layer_superbatch": 1,
    "expert_cache_layers": 4,
    "expert_store": "mmap",
    "expert_compute_dtype": "bf16",
    "gradient_transfer_dtype": "int8",
    "boundary_dtype": "bf16",
    "max_steps": 100,
    "save_every_steps": 20,
    "plot_every_steps": 5
  }
}
