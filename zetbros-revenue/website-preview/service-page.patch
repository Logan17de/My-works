@@ -0,0 +1,189 @@
+import type { Metadata } from "next";
+import Logo from "../logo";
+import { ContactTrigger } from "../contact-dialog";
+import { pageMetadata } from "../site-metadata";
+import practice from "../practice-page.module.css";
+import styles from "./agents.module.css";
+
+export const metadata: Metadata = {
+  ...pageMetadata(
+    "/agents",
+    "AI integration audit and read-only pilot — Zetbros",
+    "Start with one repeatable lookup workflow: an integration readiness audit, then a qualified read-only pilot with defined access limits and agreed tests.",
+  ),
+  // This route is a local review draft. Publication needs a separate decision.
+  robots: { index: false, follow: false },
+};
+
+const workflow = [
+  { title: "Ask for a status brief", text: "One operator starts the agreed lookup in the chosen AI client." },
+  { title: "Read the agreed records", text: "Up to three tools retrieve permitted fields from one documented API." },
+  { title: "Keep the sources visible", text: "The brief includes record identifiers or links for checking the answer." },
+  { title: "Review before using it", text: "The operator checks the result. The pilot sends no email or external notifications and changes no business records." },
+];
+
+export default function AgentsPage() {
+  return (
+    <main className={practice.page}>
+      <a className={styles.skipLink} href="#agents-content">Skip to content</a>
+      <header className={practice.header}>
+        <div className={practice.headerInner}>
+          <div className={practice.brand}><Logo small /></div>
+          <nav className={practice.nav} aria-label="Service page navigation">
+            <a href="/#software">Products</a>
+            <a href="/#business">Business</a>
+            <a href="/#research">Research</a>
+            <a href="/#about">About</a>
+            <ContactTrigger>Contact</ContactTrigger>
+          </nav>
+          <a className={practice.backLink} href="/">← Home</a>
+        </div>
+      </header>
+
+      <section className={practice.hero} id="agents-content" aria-labelledby="agents-title" tabIndex={-1}>
+        <div className={practice.container}>
+          <div className={practice.breadcrumb}><a href="/">Zetbros</a><span aria-hidden="true">/</span><span>AI integrations</span></div>
+          <div className={styles.draftLabel}>Local preview · Unpublished service-page draft</div>
+          <p className={practice.kicker}>AI agents &amp; integrations</p>
+          <h1 id="agents-title">One useful workflow. A clear place to start.</h1>
+          <p className={practice.heroLead}>Connect one repeatable lookup task to your chosen AI client, with a defined tool set, access limits and evidence from agreed tests.</p>
+          <p>Start with the workflow and its constraints. A readiness audit can lead to a small read-only pilot, or a clear recommendation not to build it.</p>
+          <div className={styles.actions}>
+            <ContactTrigger className={practice.primary} subject="AI integration workflow">Discuss your workflow <span aria-hidden="true">→</span></ContactTrigger>
+            <a className={styles.secondary} href="#pilot-scope">See the pilot scope <span aria-hidden="true">↓</span></a>
+          </div>
+          <div className={styles.draftNote}>Prepared for review. This draft describes a proposed service, not customer results or verified production capabilities. Scope, fees, schedule and terms must be agreed before work starts.</div>
+        </div>
+      </section>
+
+      <section className={styles.section} aria-labelledby="workflow-title">
+        <div className={practice.container}>
+          <div className={styles.intro}>
+            <p className={practice.kicker}>A practical first workflow</p>
+            <h2 id="workflow-title">From repeated lookups to a source-linked brief.</h2>
+            <p>A service-request status brief is one possible starting point. The first version stays inside a single system and leaves the decision with a person.</p>
+          </div>
+          <div className={styles.workflowPanel} data-glass>
+            <p className={styles.caption}>Illustrative workflow, not a customer case study</p>
+            <ol className={styles.workflow}>
+              {workflow.map((step, index) => (
+                <li key={step.title}>
+                  <span className={styles.stepNumber} aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
+                  <h3>{step.title}</h3>
+                  <p>{step.text}</p>
+                </li>
+              ))}
+            </ol>
+          </div>
+        </div>
+      </section>
+
+      <section className={styles.section} id="offer" aria-labelledby="offer-title">
+        <div className={practice.container}>
+          <div className={styles.intro}>
+            <p className={practice.kicker}>Two steps, each with a decision</p>
+            <h2 id="offer-title">Check the fit. Then test a small implementation.</h2>
+          </div>
+          <div className={styles.offers}>
+            <article className={styles.offer} data-glass aria-labelledby="audit-title">
+              <p className={styles.stage}>01 · Start with feasibility</p>
+              <h3 id="audit-title">Integration Readiness Audit</h3>
+              <p>Map one workflow and check whether a small AI integration is practical, using the API documentation and redacted or synthetic examples.</p>
+              <ul>
+                <li>A workflow map and proposed tool list</li>
+                <li>Access and data-flow requirements</li>
+                <li>Acceptance checks, risks and unresolved dependencies</li>
+                <li>A go or no-go recommendation, with a pilot proposal if the scope fits</li>
+              </ul>
+              <p className={styles.offerNote}>The audit is paid work. It does not include implementation, privileged live-account access or a security certification. Its fee is not automatically credited against a later pilot.</p>
+              <ContactTrigger className={styles.offerCta} subject="AI integration readiness audit">Discuss an audit <span aria-hidden="true">→</span></ContactTrigger>
+            </article>
+            <article className={styles.offer} data-glass aria-labelledby="pilot-title">
+              <p className={styles.stage}>02 · After technical qualification</p>
+              <h3 id="pilot-title">Agent Integration Pilot</h3>
+              <p>Connect one agreed lookup workflow and test it with a named operator in one agreed AI client and version.</p>
+              <ul>
+                <li>One documented API and one existing customer account or tenant</li>
+                <li>Up to three read-only tools with a fixed field and record scope</li>
+                <li>Connector source, configuration examples and test results</li>
+                <li>One installation in an existing approved environment, an operating guide and a handoff</li>
+              </ul>
+              <p className={styles.offerNote}>This is a supervised evaluation. Production use needs a separate release decision. The customer approves data-processing destinations and supplies existing account, model and hosting access; ongoing operation is separately scoped.</p>
+              <ContactTrigger className={styles.offerCta} subject="Read-only AI integration pilot">Discuss a pilot <span aria-hidden="true">→</span></ContactTrigger>
+            </article>
+          </div>
+          <p className={styles.feeNote}>A fixed scope and fee are proposed after qualification. No price, delivery date or commercial commitment is established by this draft.</p>
+        </div>
+      </section>
+
+      <section className={styles.section} id="pilot-scope" aria-labelledby="scope-title">
+        <div className={practice.container}>
+          <div className={styles.intro}>
+            <p className={practice.kicker}>The first pilot has a boundary</p>
+            <h2 id="scope-title">Read the right records. Keep changes out of scope.</h2>
+            <p>A tool name or a read-only annotation does not establish an access boundary. We first check the actual permitted API operations and account restrictions. If suitable restricted access is unavailable, we re-scope or stop.</p>
+          </div>
+          <div className={styles.boundaries}>
+            <div>
+              <h3>Included in a qualified pilot</h3>
+              <ul>
+                <li>Typed inputs, permitted endpoints and bounded results</li>
+                <li>Handling for missing records, permission errors, timeouts and rate limits</li>
+                <li>Source identifiers so the operator can verify the output</li>
+                <li>Minimized operational events, checked against the agreed data limits</li>
+                <li>A finite test report, access-revocation instructions and one consolidated review</li>
+              </ul>
+            </div>
+            <div>
+              <h3>Requires a separate scope</h3>
+              <ul>
+                <li>Email sends, record edits, deletion, payments and bulk exports</li>
+                <li>Unattended execution, schedules and external notifications</li>
+                <li>New OAuth infrastructure, SSO or multi-user authorization</li>
+                <li>A second system, custom dashboard or interface</li>
+                <li>Hosting subscriptions, ongoing monitoring, uptime commitments and production security work</li>
+              </ul>
+            </div>
+          </div>
+          <p className={styles.boundaryNote}>Sensitive or regulated data requires a separate review. The entry pilot does not cover medical records, regulated financial decisions, legal advice, recruiting selection or children’s information.</p>
+        </div>
+      </section>
+
+      <section className={styles.section} id="acceptance" aria-labelledby="acceptance-title">
+        <div className={practice.container}>
+          <div className={styles.acceptance}>
+            <div>
+              <p className={practice.kicker}>Evidence before expansion</p>
+              <h2 id="acceptance-title">Agree on what a useful result looks like.</h2>
+              <p>Define representative examples and expected outputs before implementation. Technical acceptance and measured business value are separate decisions.</p>
+            </div>
+            <ol className={styles.checks}>
+              <li><h3>Check the boundaries</h3><p>Test the permitted records and tools, malformed inputs, revoked access, missing data and upstream failures.</p></li>
+              <li><h3>Review the client behavior</h3><p>Inspect normal, ambiguous and out-of-scope requests in the named client. Record limitations and failures; finite tests do not prove immunity to prompt injection.</p></li>
+              <li><h3>Measure the workflow</h3><p>Compare a small set of manual and pilot-assisted cases, including review and correction time. Any saving is an observation, not a guarantee.</p></li>
+              <li><h3>Hand over the controls</h3><p>The operator practices the agreed lookup, finds its operational event and can disable or revoke access before deciding whether to expand.</p></li>
+            </ol>
+          </div>
+        </div>
+      </section>
+
+      <section className={practice.cta} id="discovery" aria-labelledby="discovery-title">
+        <div className={practice.container}>
+          <div className={practice.ctaBox} data-glass>
+            <p className={practice.kicker}>Start with the work you repeat</p>
+            <h2 id="discovery-title">Which lookup does your team do every week?</h2>
+            <p>Tell us the task, which single system it lives in, how often it happens and who owns access. A link to public API documentation is useful. We can assess whether it fits a small paid audit.</p>
+            <p>Please do not include passwords, API keys, customer records or confidential documents in the initial enquiry. No upload or live-account access is needed to start the conversation.</p>
+            <ContactTrigger className={practice.primary} subject="AI integration workflow">Discuss your workflow <span aria-hidden="true">→</span></ContactTrigger>
+          </div>
+        </div>
+      </section>
+
+      <footer className={practice.footer}>
+        <div className={`${practice.container} ${practice.footerInner}`}>
+          <div className={practice.footerLinks}><a href="/">Zetbros</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a></div>
+        </div>
+      </footer>
+    </main>
+  );
+}
