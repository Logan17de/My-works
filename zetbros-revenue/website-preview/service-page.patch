+++ b/app/agents/agents.module.css
@@ -0,0 +1,60 @@
+.skipLink { position: fixed; top: 12px; left: 12px; z-index: 100; padding: 12px 20px; border: 1px solid var(--blue); border-radius: var(--control-radius); background: var(--surface); color: var(--blue); transform: translateY(-180%); }
+.skipLink:focus { transform: none; }
+.draftLabel { display: inline-block; margin: 0 0 24px; padding: 7px 12px; border: 1px solid var(--line); border-radius: var(--control-radius); color: var(--muted); font-size: .8125rem; line-height: 1.5; }
+.actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; margin-top: 28px; }
+.actions > button { margin-top: 0; gap: 16px; }
+.secondary { display: inline-flex; align-items: center; gap: 12px; min-height: 48px; color: var(--blue); font-size: .9375rem; font-weight: 600; }
+.secondary:hover { color: var(--blue-2); }
+.draftNote { max-width: 78ch; margin: 24px 0 0; color: var(--muted); font-size: .875rem; }
+.section { padding: 32px 0 var(--section-space); }
+.intro { max-width: 840px; margin-bottom: 32px; }
+.intro h2, .acceptance h2 { max-width: 24ch; margin-bottom: 20px; }
+.intro > p:not(:first-child), .acceptance > div > p:not(:first-child) { max-width: 68ch; margin-bottom: 0; color: var(--muted); font-size: 1.0625rem; }
+.workflowPanel { padding: clamp(24px, 3vw, 36px); border: 1px solid var(--line); border-radius: var(--radius); }
+.caption { margin: 0 0 24px; color: var(--blue); font-size: .875rem; font-weight: 550; }
+.workflow { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 28px; margin: 0; padding: 0; list-style: none; }
+.workflow li { min-width: 0; }
+.stepNumber { display: block; margin-bottom: 16px; color: var(--blue); font-size: .875rem; font-weight: 600; }
+.workflow h3 { margin: 0 0 10px; font-size: 1.0625rem; line-height: 1.4; }
+.workflow p { margin: 0; color: var(--muted); font-size: .9375rem; line-height: 1.65; }
+.offers { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 24px; }
+.offer { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; padding: clamp(24px, 3vw, 36px); border: 1px solid var(--line); border-radius: var(--radius); }
+.stage { margin: 0 0 24px; color: var(--blue); font-size: .875rem; font-weight: 550; }
+.offer h3 { max-width: 22ch; margin: 0 0 20px; font-size: clamp(1.5rem, 1.2rem + .7vw, 1.875rem); line-height: 1.25; }
+.offer > p:not(.stage) { color: var(--muted); }
+.offer ul { margin: 8px 0 24px; }
+.offer li, .boundaries li { margin: 8px 0; padding-left: 4px; }
+.offer ul, .boundaries ul { padding-left: 20px; color: var(--text); }
+.offer li::marker, .boundaries li::marker { color: var(--blue); }
+.offerNote { font-size: .875rem; line-height: 1.7; }
+.offerCta { margin-top: auto; }
+.feeNote { max-width: 78ch; margin: 24px 0 0; color: var(--muted); font-size: .875rem; }
+.boundaries { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: clamp(28px, 6vw, 72px); }
+.boundaries > div { min-width: 0; padding-top: 24px; border-top: 1px solid var(--line); }
+.boundaries h3 { margin-bottom: 16px; font-size: 1.125rem; }
+.boundaries ul { margin: 0; }
+.boundaryNote { max-width: 86ch; margin: 32px 0 0; padding-left: 20px; border-left: 2px solid var(--blue); color: var(--muted); font-size: .9375rem; }
+.acceptance { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: clamp(32px, 6vw, 80px); }
+.acceptance > div { min-width: 0; }
+.checks { counter-reset: acceptance; display: grid; gap: 24px; margin: 0; padding: 0; list-style: none; }
+.checks li { counter-increment: acceptance; display: grid; grid-template-columns: 28px minmax(0,1fr); gap: 6px 16px; padding-top: 18px; border-top: 1px solid var(--line); }
+.checks li::before { content: "0" counter(acceptance); grid-row: 1 / 3; color: var(--blue); font-size: .875rem; font-weight: 600; }
+.checks h3 { margin: 0; font-size: 1.0625rem; }
+.checks p { grid-column: 2; margin: 0; color: var(--muted); font-size: .9375rem; }
+@media (max-width: 1000px) {
+  .workflow { grid-template-columns: repeat(2, minmax(0,1fr)); gap: 32px; }
+}
+@media (max-width: 760px) {
+  .section { padding-top: 24px; }
+  .offers, .boundaries, .acceptance { grid-template-columns: minmax(0,1fr); gap: 28px; }
+}
+@media (max-width: 599px) {
+  .workflow { grid-template-columns: minmax(0,1fr); gap: 24px; }
+  .workflow li { display: grid; grid-template-columns: 28px minmax(0,1fr); gap: 8px 16px; }
+  .stepNumber { grid-row: 1 / 3; margin: 0; }
+  .workflow h3 { margin: 0; }
+  .workflow p { grid-column: 2; }
+  .actions { align-items: stretch; gap: 8px; }
+  .actions > button, .secondary { flex: 1 1 100%; justify-content: center; }
+  .draftLabel { font-size: .75rem; }
+}
