# Groww authentication: choose one supported flow.
GROWW_ACCESS_TOKEN=
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_TOTP_TOKEN=
GROWW_TOTP_SECRET=

# Execution in this repository is paper-only.
EXECUTION_MODE=paper

# Optional Supabase sink. Never expose SERVICE_ROLE_KEY in a browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Web app variables (apps/web)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
